{
  "name": "app",
  "version": "3.0.0",
  "description": "Village profile app",
  "private": false,
  "homepage": "https://vpapp1.github.io/village-profile-app",
  "dependencies": {
  "@testing-library/jest-dom": "^5.11.4",
  "@testing-library/react": "^11.1.0",
  "@testing-library/user-event": "^12.1.10",
  "@types/jest": "^26.0.15",
  "@types/node": "^12.0.0",
  "@types/react": "^16.9.53",
  "@types/react-dom": "^16.9.8",
  "@types/react-router-dom": "^5.1.8",
  "axios": "^0.21.1",
  "dexie": "^3.2.0-beta.3",
  "dexie-react-hooks": "^1.0.7",
  "json-server": "^0.17.0",
  "multiselect-react-dropdown": "^2.0.17",
  "react": "^17.0.2",
  "react-dom": "^17.0.2",
  "react-router-dom": "^5.2.0",
  "react-scripts": "5.0.1",
  "universal-cookie": "^4.0.4",
  "web-vitals": "^0.2.4",
  "workbox-background-sync": "^5.1.3",
  "workbox-broadcast-update": "^5.1.3",
  "workbox-cacheable-response": "^5.1.3",
  "workbox-core": "^5.1.3",
  "workbox-expiration": "^5.1.3",
  "workbox-google-analytics": "^5.1.3",
  "workbox-navigation-preload": "^5.1.3",
  "workbox-precaching": "^5.1.3",
  "workbox-range-requests": "^5.1.3",
  "workbox-routing": "^5.1.3",
  "workbox-strategies": "^5.1.3",
  "workbox-streams": "^5.1.3"
},
  "devDependencies": {
  "concurrently": "^9.0.1",
  "gh-pages": "^3.2.3",
  "typescript": "^4.9.5"
},
  "scripts": {
    "start": "set NODE_OPTIONS=--openssl-legacy-provider && react-scripts start",
    "db": "json-server --watch src/server.json --port 8000",
    "start:all": "concurrently \"set NODE_OPTIONS=--openssl-legacy-provider && react-scripts start\" \"npm run db\"",
    "build": "set NODE_OPTIONS=--openssl-legacy-provider && node scripts/build.js",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d build"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
 }
